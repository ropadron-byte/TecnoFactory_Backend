# Se copia al servidor como /opt/tecnofactory/.env  (chmod 600)
# Secretos: openssl rand -hex 32  (uno distinto para cada clave)
# Sin comentarios al final de la línea de un valor.

# Root de MySQL
DB_PASSWORD=CAMBIAR
# Flyway (crea/modifica tablas)
MIGRATOR_PASSWORD=CAMBIAR
# La app (solo SELECT/INSERT/UPDATE/DELETE)
APP_DB_PASSWORD=CAMBIAR

# Mínimo 32 caracteres
JWT_SECRET=CAMBIAR
GOOGLE_CLIENT_ID=CAMBIAR.apps.googleusercontent.com

# URL EXACTA del frontend (sin "/" final). Varias separadas por coma.
CORS_ORIGINS=http://IP_O_DOMINIO_DEL_FRONTEND

# Administrador inicial (la clave debe cumplir ValidadorClaves)
ADMIN_EMAIL=admin@tudominio.cl
ADMIN_PASSWORD=CAMBIAR

# Imágenes subidas
UPLOADS_HOST_DIR=/opt/tecnofactory/uploads
