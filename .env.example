# Copia este archivo a .env y completa los valores.
# .env no se versiona: contiene claves reales.

# Clave de root de MySQL (perfil local y contenedor)
DB_PASSWORD=cambia_esta_clave

# Clave de tecnofactory_migrator (Flyway)
MIGRATOR_PASSWORD=cambia_esta_clave

# Clave de tecnofactory_app (la app en producción)
APP_DB_PASSWORD=cambia_esta_clave

# Conexión local: MySQL se publica en el 3307 del host
DB_URL=jdbc:mysql://localhost:3307/tecnofactory

# Firma de tokens JWT (mínimo 32 caracteres)
JWT_SECRET=cambia_esta_clave_por_una_de_al_menos_32_caracteres

# Administrador inicial (solo se usa al crear el primer admin)
ADMIN_EMAIL=admin@tecnofactory.cl
ADMIN_PASSWORD=cambia_esta_clave

# Perfil de Spring
SPRING_PROFILES_ACTIVE=local
