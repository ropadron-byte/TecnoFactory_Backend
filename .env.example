# Copia este archivo a .env y completa los valores.
# .env no se versiona: contiene claves reales.
# Genera secretos con: openssl rand -hex 32

# --- Base de datos ---
# Clave de root de MySQL (perfil local y contenedor)
DB_PASSWORD=CAMBIAR

# Clave de tecnofactory_migrator (Flyway)
MIGRATOR_PASSWORD=CAMBIAR

# Clave de tecnofactory_app (la app en el contenedor)
APP_DB_PASSWORD=CAMBIAR

# Conexión local: MySQL se publica en el 3307 del host
DB_URL=jdbc:mysql://localhost:3307/tecnofactory
DB_USER=root

# Solo perfil prod: usuario y clave que usa Flyway para migrar
FLYWAY_USER=
FLYWAY_PASSWORD=

# --- Firma de tokens JWT (mínimo 32 bytes) ---
JWT_SECRET=CAMBIAR_ESTA_CLAVE_POR_UNA_ALEATORIA_DE_AL_MENOS_32_CARACTERES

# --- Administrador inicial (solo se usa al crear el primer admin) ---
ADMIN_EMAIL=admin@tecnofactory.cl
ADMIN_PASSWORD=CAMBIAR
ADMIN_RUN=11111111
ADMIN_RUN_DV=1
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDOS=TecnoFactory
ADMIN_FECHA_NACIMIENTO=2000-01-01
ADMIN_DIRECCION=Por definir
ADMIN_TELEFONO=+56900000000
ADMIN_COMUNA=13101

# --- Aplicación ---
SPRING_PROFILES_ACTIVE=local
CORS_ORIGINS=http://localhost:5173
UPLOADS_DIR=./uploads
# Solo con Docker: carpeta del servidor donde viven las imágenes subidas (se monta en
# /app/uploads del contenedor). Nunca queda dentro de la imagen ni del contenedor.
UPLOADS_HOST_DIR=./uploads

# --- Redis y correo (valores por defecto para desarrollo) ---
REDIS_HOST=localhost
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
